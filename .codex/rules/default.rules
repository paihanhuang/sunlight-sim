# Project-local Codex approval rules.
# These apply when Codex asks to run commands outside the sandbox.

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only repository inspection is safe.",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only repository inspection is safe.",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only repository inspection is safe.",
)

prefix_rule(
    pattern = ["git", "branch"],
    decision = "allow",
    justification = "Read-only branch inspection is safe.",
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "Read-only repository inspection is safe.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive history and working-tree operation. Ask the user for explicit instructions and use a safer revert path.",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Destructive untracked-file deletion. Ask the user for explicit instructions first.",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force pushing can rewrite shared history. Ask the user for explicit approval and prefer --force-with-lease.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force pushing can rewrite shared history. Ask the user for explicit approval and prefer --force-with-lease.",
)

