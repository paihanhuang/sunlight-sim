{
  "name": "sun-light-sim",
  "version": "0.1.0",
  "description": "Photorealistic sunlight simulator for real estate property review.",
  "private": true,
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --headed",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:year-round": "RUN_YEAR_ROUND_50=true playwright test e2e/year-round-50-locations.spec.ts --headed",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e:headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paihanhuang/codex-project-template.git"
  },
  "keywords": [
    "sunlight",
    "real-estate",
    "cesium",
    "google-maps"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/paihanhuang/codex-project-template/issues"
  },
  "homepage": "https://github.com/paihanhuang/codex-project-template#readme",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "cesium": "^1.141.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tz-lookup": "^6.1.25",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/google.maps": "^3.64.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
